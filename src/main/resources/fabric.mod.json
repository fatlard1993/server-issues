{
	"schemaVersion": 1,
	"id": "server-issues",
	"version": "${version}",
	"name": "Server Issues",
	"description": "Players report bugs, ideas and grief in game, and staff work through them",
	"authors": [
		"justfatlard"
	],
	"license": "MIT",
	"icon": "assets/server-issues/icon.png",
	"environment": "*",
	"entrypoints": {
